# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/happy_balance"

# Server
PORT=14040
NODE_ENV=development

# CORS - comma-separated list of allowed origins
# In development mode, any localhost origin is automatically allowed
CORS_ORIGIN="http://localhost:5173,http://localhost:5177"

# File upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="uploads"

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Security
JWT_ACCESS_SECRET=dev-secret-key-minimum-32-characters-long-for-jwt-access
JWT_REFRESH_SECRET=dev-refresh-key-minimum-32-characters-long-for-jwt-refresh

# Magic Link Auth (optional - for lead capture)
# MAGIC_LINK_SECRET=dev-magic-link-secret-minimum-32-characters-long
# APP_URL=http://localhost:5173

# Supabase (optional - for lead storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Resend (optional - for magic link emails)
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=Happy Balance <noreply@yourdomain.com>