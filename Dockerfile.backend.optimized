# Multi-stage build for production backend (Best practices with pnpm deploy)
FROM node:20-alpine AS base

# Build arguments for version tracking
ARG VERSION=unknown
ARG COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Build stage - install all deps and build
FROM base AS build
COPY . /usr/src/app
WORKDIR /usr/src/app
# Use BuildKit cache mount for faster installs
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install
# Generate Prisma Client
WORKDIR /usr/src/app/apps/backend
RUN pnpm prisma generate
# Build application
RUN pnpm build

# Deploy stage - create production-ready standalone package
WORKDIR /usr/src/app
RUN pnpm deploy --filter=happy-balance-backend --prod /prod/backend

# Generate Prisma Client in deployed directory
WORKDIR /prod/backend
RUN npx prisma generate

# Production stage - minimal runtime image.
# Using debian-slim (not alpine) to avoid the Synology NAS busybox-trigger bug
# that kills `apk add` mid-install during DSM container builds. Same fix the
# frontend Dockerfile already applies.
FROM node:20-slim AS production

# Re-declare ARGs for this stage
ARG VERSION=unknown
ARG COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

RUN apt-get update && \
    apt-get install -y --no-install-recommends wget dumb-init && \
    rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app

# Copy deployed package (all dependencies resolved, no symlinks, includes generated Prisma Client)
COPY --from=build /prod/backend /app

# Copy built application
COPY --from=build /usr/src/app/apps/backend/dist ./dist

# Create version file with build metadata
RUN echo "{\"version\":\"${VERSION}\",\"commit\":\"${COMMIT_SHA}\",\"buildTimestamp\":\"${BUILD_TIMESTAMP}\",\"component\":\"backend\"}" > /app/.version.json

# Create uploads directory and non-root user
RUN mkdir -p uploads && \
    groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m -s /bin/sh backend && \
    chown -R backend:nodejs /app

USER backend

EXPOSE 3004

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3004/health || exit 1

ENV NODE_ENV=production \
    PORT=3004 \
    NODE_OPTIONS="--max-old-space-size=512"

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/main.js"]
